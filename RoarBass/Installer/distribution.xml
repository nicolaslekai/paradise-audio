<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>RoarBass</title>
    <organization>com.anthropic</organization>
    <welcome    file="welcome.txt"    mime-type="text/plain"/>
    <conclusion file="conclusion.txt" mime-type="text/plain"/>
    <options customize="never" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <volume-check>
        <allowed-os-versions>
            <os-version min="11.0"/>
        </allowed-os-versions>
    </volume-check>
    <choices-outline>
        <line choice="default">
            <line choice="com.anthropic.RoarBass.pkg"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="com.anthropic.RoarBass.pkg" visible="false">
        <pkg-ref id="com.anthropic.RoarBass.pkg"/>
    </choice>
    <pkg-ref id="com.anthropic.RoarBass.pkg" version="1.0.0" onConclusion="none">RoarBass-component.pkg</pkg-ref>
</installer-gui-script>
